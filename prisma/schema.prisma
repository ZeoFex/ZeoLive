generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum AdminTier {
  SUPERADMIN
  SUBADMIN
}

enum SchoolType {
  HOME_SCHOOL
  PUBLIC_SCHOOL
  PRIVATE_SCHOOL
}

enum TutorEducationLevel {
  UNDERGRADUATE_CONTINUING
  DIPLOMA_HND
  GRADUATE
  POSTGRADUATE
}

enum TutorVerificationStatus {
  PENDING
  NOT_QUALIFIED
  AWAITING_RECOMMENDATION
  AWAITING_REVIEW
  AWAITING_SUPERADMIN
  APPROVED
  REJECTED
}

enum RecommenderTitle {
  DR
  PROF
}

model User {
  id              String    @id @default(cuid())
  name            String?
  firstName       String?
  middleName      String?
  lastName        String?
  dateOfBirth     DateTime?
  email           String    @unique
  emailVerified   DateTime?
  phone           String?
  country         String?
  regionState     String?
  termsAcceptedAt DateTime?
  image           String?
  passwordHash    String?
  role            Role      @default(STUDENT)
  adminTier       AdminTier?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  tutorProfile   TutorProfile?
  studentProfile StudentProfile?

  tutoringSessionsAsStudent TutoringSession[] @relation("StudentTutoringSessions")
  tutoringSessionsAsTutor   TutoringSession[] @relation("TutorTutoringSessions")
  sessionParticipations     SessionParticipant[] @relation("SessionParticipants")

  conversationsAsStudent TutorStudentConversation[] @relation("ConversationStudent")
  conversationsAsTutor   TutorStudentConversation[] @relation("ConversationTutor")
  sentMessages           StoredMessage[]            @relation("MessageSender")

  studyMaterialsAsTutor    StudyMaterial[] @relation("TutorStudyMaterials")
  materialSharesReceived   MaterialShare[] @relation("StudentMaterialShares")

  lectureSubjects LectureSubject[] @relation("TutorLectureSubjects")
  lectureVideos   LectureVideo[]   @relation("TutorLectureVideos")

  sessionRecordingsUploaded SessionRecording[]        @relation("RecordingUploader")
  recordingDownloadRequests RecordingDownloadRequest[] @relation("RecordingDownloadRequester")
  recordingDownloadsReviewed RecordingDownloadRequest[] @relation("RecordingDownloadReviewer")
}

enum TutoringSessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model TutoringSession {
  id          String                @id @default(cuid())
  roomId      String                @unique
  studentId   String
  tutorId     String
  student     User                  @relation("StudentTutoringSessions", fields: [studentId], references: [id], onDelete: Cascade)
  tutor       User                  @relation("TutorTutoringSessions", fields: [tutorId], references: [id], onDelete: Cascade)
  title       String?
  subject     String?
  status      TutoringSessionStatus @default(SCHEDULED)
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  storedMessages StoredMessage[]
  recordings     SessionRecording[]
  participants   SessionParticipant[]

  @@index([studentId])
  @@index([tutorId])
  @@index([status])
}

model SessionParticipant {
  id                String          @id @default(cuid())
  tutoringSessionId String
  studentId         String
  tutoringSession   TutoringSession @relation(fields: [tutoringSessionId], references: [id], onDelete: Cascade)
  student           User            @relation("SessionParticipants", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([tutoringSessionId, studentId])
  @@index([studentId])
}

enum RecordingSource {
  MANUAL
  EGRESS
}

enum RecordingDownloadStatus {
  PENDING
  APPROVED
  REJECTED
  DOWNLOADED
}

model SessionRecording {
  id                String          @id @default(cuid())
  tutoringSessionId String
  tutoringSession   TutoringSession @relation(fields: [tutoringSessionId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User            @relation("RecordingUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  title             String
  description       String?
  fileUrl           String
  fileName          String
  mimeType          String?
  fileSizeBytes     Int
  durationSeconds   Int?
  source            RecordingSource @default(MANUAL)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  downloadRequests RecordingDownloadRequest[]

  @@index([tutoringSessionId, createdAt])
  @@index([uploadedById])
  @@index([createdAt])
}

model RecordingDownloadRequest {
  id              String                  @id @default(cuid())
  recordingId     String
  recording       SessionRecording        @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User                    @relation("RecordingDownloadRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterEmail  String
  status          RecordingDownloadStatus @default(PENDING)
  accessCode      String?
  reviewedById    String?
  reviewedBy      User?                   @relation("RecordingDownloadReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  downloadToken   String?                 @unique
  downloadedAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([recordingId, requesterId])
  @@index([status, createdAt])
  @@index([requesterEmail])
}

enum MessageChannel {
  DIRECT
  CLASSROOM
}

model TutorStudentConversation {
  id        String   @id @default(cuid())
  studentId String
  tutorId   String
  student   User     @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor     User     @relation("ConversationTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  messages  StoredMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, tutorId])
  @@index([studentId])
  @@index([tutorId])
  @@index([updatedAt])
}

model StoredMessage {
  id                String                 @id @default(cuid())
  conversationId    String
  conversation      TutorStudentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String
  sender            User                   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body              String                 @db.Text
  channel           MessageChannel
  tutoringSessionId String?
  tutoringSession   TutoringSession?       @relation(fields: [tutoringSessionId], references: [id], onDelete: SetNull)
  clientMessageId   String?
  createdAt         DateTime               @default(now())

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([tutoringSessionId])
  @@index([createdAt])
}

model StudentProfile {
  id                String     @id @default(cuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolType        SchoolType
  schoolName        String?
  schoolRegionState String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Programme {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjects Subject[]
  tutors   TutorProfile[]
}

model Subject {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tutorSubjects TutorSubject[]

  @@unique([programmeId, name])
  @@unique([programmeId, slug])
  @@index([programmeId, active])
}

model TutorSubject {
  tutorProfileId String
  subjectId      String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([tutorProfileId, subjectId])
  @@index([subjectId])
}

model TutorProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  subjects           String[]                @default([])
  programmeId        String?
  programme          Programme?              @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  hourlyRate         Float?
  experience         String?
  educationLevel     TutorEducationLevel?
  institutionName    String?
  transcriptUrl      String?
  certificateUrl     String?
  nationalIdUrl      String?
  livePhotoUrl       String?
  onboardingComplete Boolean                 @default(false)
  verificationStatus TutorVerificationStatus @default(PENDING)
  verified           Boolean                 @default(false)
  rating             Float                   @default(4.8)
  reviewCount        Int                     @default(0)
  featuredOnHomepage Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  tutorSubjects   TutorSubject[]
  recommendations TutorRecommendation[]
  subadminReviews TutorSubadminReview[]

  @@index([programmeId])
}

model TutorSubadminReview {
  id             String       @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewerName   String
  checkedItems   String[]     @default([])
  createdAt      DateTime     @default(now())

  @@unique([tutorProfileId, reviewerId])
  @@index([tutorProfileId])
}

model TutorRecommendation {
  id                  String           @id @default(cuid())
  tutorProfileId      String
  tutorProfile        TutorProfile     @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  title               RecommenderTitle
  recommenderFirstName String
  recommenderLastName  String
  departmentName      String
  recommenderSchoolName String @default("")
  recommenderEmail    String
  recommenderPhone    String?
  message             String?          @db.Text
  token               String           @unique
  emailSentAt         DateTime?
  submittedAt         DateTime?
  letterUrl           String?
  letterText          String?          @db.Text
  createdAt           DateTime         @default(now())

  @@index([tutorProfileId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model LectureSubject {
  id        String         @id @default(cuid())
  tutorId   String
  tutor     User           @relation("TutorLectureSubjects", fields: [tutorId], references: [id], onDelete: Cascade)
  name      String
  nameKey   String
  createdAt DateTime       @default(now())
  videos    LectureVideo[]

  @@unique([tutorId, nameKey])
  @@index([tutorId])
}

model LectureVideo {
  id            String         @id @default(cuid())
  tutorId       String
  tutor         User           @relation("TutorLectureVideos", fields: [tutorId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       LectureSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  fileUrl       String
  fileName      String
  mimeType      String?
  fileSizeBytes Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tutorId, createdAt])
  @@index([subjectId, createdAt])
}

model StudyMaterial {
  id            String          @id @default(cuid())
  tutorId       String
  tutor         User            @relation("TutorStudyMaterials", fields: [tutorId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  fileUrl       String
  fileName      String
  mimeType      String?
  fileSizeBytes Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  shares        MaterialShare[]

  @@index([tutorId, createdAt])
}

model MaterialShare {
  id         String        @id @default(cuid())
  materialId String
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  studentId  String
  student    User          @relation("StudentMaterialShares", fields: [studentId], references: [id], onDelete: Cascade)
  sharedAt   DateTime      @default(now())
  viewedAt   DateTime?

  @@unique([materialId, studentId])
  @@index([studentId, sharedAt])
}

/** Keyed landing / marketing content (JSON payloads). */
model CmsEntry {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
